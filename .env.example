# Copy to .env and fill in. The Expo CLI loads this automatically and
# app.config.ts forwards these onto Constants.expoConfig.extra
# (read in src/config/env.ts).

APP_ENV=development
APP_API_URL=https://api.example.com

# EAS build project id - set for you by `eas init`
EAS_PROJECT_ID=

# Optional: override where the native Firebase config files live
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
